# Copy to .env and fill in. See SETUP-human.md for where each value comes from.
# The app runs with every one of these blank - see "Zero-credential mode".

# --- ElevenLabs (telephony + the agent) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=

# The phone that answers as the hotel front desk. E.164, e.g. +12125551234
DEMO_TO_NUMBER=

# ngrok reserved static domain, no trailing slash. e.g. https://your-name.ngrok-free.app
PUBLIC_BASE_URL=

# --- Enrichment (all optional) ---
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
STAY22_API_KEY=

# --- Who the agent says it is calling for ---
APP_NAME=Roadio
TRAVELER_NAME=Nishanth

# Link back to the team's main dashboard, rendered in the console header.
MAIN_APP_URL=

# Force the scripted fake call even when ElevenLabs credentials exist.
# Leave blank in production; it auto-engages when credentials are missing.
CONCIERGE_FAKE_CALL=

# Send a fully-resolved prompt with each call, so the agent always knows the
# date, time and party size regardless of its dashboard prompt.
#
# LEAVE BLANK until you have enabled overrides on the agent itself
# (ElevenLabs -> your agent -> Security/Advanced). If they are not enabled the
# call is still placed and the phone still rings, but the conversation dies at
# init with "Override for field 'first_message' is not allowed by config" and
# the caller answers to silence.
ELEVENLABS_PROMPT_OVERRIDE=
