# Copy to .env and fill in. Both values are optional - see below.

# Telegram bot token, from @BotFather: send /newbot and follow the prompts.
# Optional. Without it the bot and the proactive engine stay down and only the
# web app runs.
TELEGRAM_BOT_TOKEN=

# From https://console.anthropic.com/settings/keys
# Optional if you've run `ant auth login` - the SDK picks up the profile.
ANTHROPIC_API_KEY=

# Optional overrides
ROADIO_MODEL=claude-opus-5
ROADIO_DB_PATH=./data/roadio.db
ROADIO_PHOTO_DIR=./data/photos
ROADIO_HTTP_PORT=8787
ROADIO_WEB_DIR=./web/dist

# How often the proactive engine wakes up and considers nudging (minutes).
# Per-user quiet hours and rate limits are enforced on top of this.
ROADIO_TICK_MINUTES=15
