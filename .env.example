# Copy to .env and fill in.

# OpenRouter key, from https://openrouter.ai/keys
# Required for the chat to work - `npm run smoke` runs without it, but the web
# app's conversation is fully LLM-backed and has no fallback without a key.
#
# For teams: create the key under a shared OpenRouter account and give each
# person their own via Settings > Provisioning Keys, so spend is attributable
# and one person's key can be revoked on its own. Set a credit limit per key.
OPENROUTER_API_KEY=

# Optional overrides

# An OpenRouter model slug, not an Anthropic alias. Must support `tools` and
# `structured_outputs`; captioning also needs image input. Cheap options that
# do all three (per Mtok in/out):
#   google/gemini-2.5-flash-lite   $0.10/$0.40   1M context   (default)
#   openai/gpt-5-nano              $0.05/$0.40   400K context
#   qwen/qwen3.5-flash-02-23       $0.07/$0.26   1M context
# Avoid `:batch` variants - they are async and wrong for interactive chat.
ROADIO_MODEL=google/gemini-2.5-flash-lite

# Backups tried in order when the model above is rate limited or erroring.
# Comma-separated; must support tools + structured_outputs.
ROADIO_FALLBACK_MODELS=openrouter/free,dots-studio/dots-3-note-preview:free

# Send OpenRouter's unified reasoning hint, using the per-call-site effort
# levels in src/config.ts. Worth setting false on the cheapest models, where
# reasoning tokens can cost more than they buy.
ROADIO_REASONING=true
ROADIO_DB_PATH=./data/roadio.db
ROADIO_HTTP_PORT=8787
# Chat turns allowed per visitor IP per 10 minutes, and across everyone per hour (0 = off).
ROADIO_CHAT_LIMIT_PER_IP=20
ROADIO_CHAT_LIMIT_GLOBAL=200
ROADIO_WEB_DIR=./web/dist

# Optional: Viator's hosted experience-search MCP endpoint. No API key required.
ROADIO_VIATOR_MCP_URL=https://exp-app-mcp.prod.ep.viator.com/mcp
# Use deterministic local experiences instead of making network calls.
ROADIO_VIATOR_MOCK=false
